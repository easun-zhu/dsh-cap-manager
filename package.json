{
  "name": "dsh-cap-manager",
  "version": "1.2.0",
  "type": "module",
  "description": "Unified MCP servers & skills manager panel for DeepSeek Harness (global / profile / project scopes)",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "mcp-servers",
    "skills",
    "plugin"
  ],
  "homepage": "https://github.com/easun-zhu/dsh-cap-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easun-zhu/dsh-cap-manager.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "chokidar": "^5.0.0",
    "fflate": "^0.8.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.4",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.4",
    "@deepseek-ai/dsh-home-paths": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  }
}
